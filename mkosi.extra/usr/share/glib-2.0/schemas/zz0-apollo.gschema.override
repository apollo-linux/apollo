[org.gnome.shell]
favorite-apps=['org.mozilla.firefox.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Calculator.desktop', 'org.gnome.TextEditor.desktop', 'io.github.kolunmi.Bazaar.desktop']

[org.gnome.desktop.interface]
accent-color='purple'

[org.gnome.login-screen]
logo='/usr/share/apollo/assets/watermark.svg'

[org.gnome.desktop.background]
picture-uri="file:///usr/share/backgrounds/apollo/apollo-light.png"
picture-uri-dark="file:///usr/share/backgrounds/apollo/apollo-dark.png"

[org.gnome.shell]
always-show-log-out=true